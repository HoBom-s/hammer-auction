{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092"
  },
  "InternalApi": {
    "BaseUri": "http://localhost:8090/"
  },
  "Cleanup": {
    "KamcoRetentionDays": 90,
    "InstitutionRetentionDays": 90,
    "RealEstateTradeRetentionDays": 1095,
    "CleanupHourUtc": 18
  },
  "AllowedHosts": "*"
}
